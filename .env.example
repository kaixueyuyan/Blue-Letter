# Formspree form IDs. These identify a public form endpoint. They are not an account password.
# Create one form for volunteers and one for partner organizations, then paste each form's ID.
# Restart `next dev` after editing .env.local. On Vercel, set the same names before the build.
# NEXT_PUBLIC_ values are inlined when the site is built.
NEXT_PUBLIC_FORMSPREE_VOLUNTEER_ID=
NEXT_PUBLIC_FORMSPREE_ORGANIZATION_ID=
